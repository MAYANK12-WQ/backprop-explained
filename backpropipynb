      "source": [
        "# 🎛️ Multi-Neuron Playground (fixed for your Value class)\n",
        "import ipywidgets as w\n",
        "\n",
        "# simple 2-layer perceptron\n",
        "layer = Layer(2, 2)\n",
        "\n",
        "def explore(a=1.0, b=-1.0):\n",
        "    # create values without label\n",
        "    x1, x2 = Value(a), Value(b)\n",
        "    # assign labels after\n",
        "    x1.label, x2.label = 'a', 'b'\n",
        "    x = [x1, x2]\n",
        "\n",
        "    # forward pass\n",
        "    out = layer(x)[0]  # take first neuron output\n",
        "    out.label = 'playground_out'\n",
        "\n",
        "    # reset grads\n",
        "    for v in layer.parameters() + [x1, x2]:\n",
        "        v.grad = 0.0\n",
        "\n",
        "    # backprop\n",
        "    out.backward()\n",
        "\n",
        "    return draw_dot(out)\n",
        "\n",
        "# interactive sliders (works in Colab/Jupyter)\n",
        "w.interact(explore,\n",
        "           a=w.FloatSlider(min=-3, max=3, step=0.1, value=1.0),\n",
        "           b=w.FloatSlider(min=-3, max=3, step=0.1, value=-1.0))\n"
